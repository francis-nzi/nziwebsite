# Copy to .env for local development. On Render these are set in the dashboard.
DATABASE_URL=postgres://user:password@localhost:5432/nzi
# TLS is switched on automatically for Supabase or sslmode=require URLs; force it with:
# DATABASE_SSL=true

# Email notifications for enquiries and bookings (https://resend.com)
RESEND_API_KEY=
NOTIFY_TO=info@netzero.international
NOTIFY_FROM=Net Zero International Website <website@netzero.international>
